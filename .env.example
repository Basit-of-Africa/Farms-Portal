# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string (e.g., railway, Neon, Supabase) for persistent cloud storage.
# You can use a domain hostname (e.g. db.example.com) or standard cloud server address.
# Example: postgresql://postgres:password@db.example.com:5432/database?sslmode=require
DATABASE_URL=""

# Firebase / Firestore (optional cloud persistence)
# The server uses the server-side Firestore SDK. It authenticates with a Google
# service account, NOT with the web API key:
#   - on Cloud Run / GCP: the runtime service account (needs the "Cloud Datastore User" role)
#   - elsewhere: set FIREBASE_SERVICE_ACCOUNT to the service account JSON key (one line),
#     or GOOGLE_APPLICATION_CREDENTIALS to the path of the key file.
# Project/database come from firebase-applet-config.json, FIREBASE_CONFIG, or:
FIREBASE_PROJECT_ID=""
FIREBASE_DATABASE_ID=""
FIREBASE_SERVICE_ACCOUNT=""

# AUTH_SECRET: secret used to sign session tokens (at least 32 random characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# If unset, a secret is generated and stored in data/.auth-secret.
# Required if you run more than one server instance.
AUTH_SECRET=""

# AUTH_TOKEN_TTL_SECONDS: how long a sign-in lasts (default 43200 = 12 hours).
AUTH_TOKEN_TTL_SECONDS=""

# ADMIN_INITIAL_PASSWORD: used only if no admin account has a password yet
# (e.g. first boot). The admin must change it at first sign-in. If unset, a
# random one-time password is printed to the server log.
ADMIN_INITIAL_PASSWORD=""

# TRUST_PROXY: Express "trust proxy" setting (default 1 = one reverse proxy hop).
TRUST_PROXY=""
