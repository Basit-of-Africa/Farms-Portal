rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // All data access goes through the portal's server, which uses the
    // server-side Firestore SDK with a service account (not subject to these
    // rules). Direct access from browsers or other clients is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
